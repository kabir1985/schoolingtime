                            FROM 
                                teacher_registration 
                            LEFT JOIN 
                                teacher_profile 
                            ON 
                                teacher_registration.teacher_id = teacher_profile.teacher_id 
                        ) AS tr
                        ON tr.teacher_id = tc.course_teacher_id
                        LEFT JOIN course_batch AS cb 
                        ON cb.course_id = tc.course_id
                        WHERE 
                            tc.course_status != \'pending\'
                            GROUP BY 
